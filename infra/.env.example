# Radio Aha · infra/.env
# Local dev: copy as-is (defaults work).  Production (Oracle VM): fill in every "PROD" line.
# Generate secrets with:  openssl rand -hex 24   (hex = URL-safe, no quoting problems)

# PROD: uncomment to also run the API and Caddy (HTTPS) in Docker.
# COMPOSE_PROFILES=prod

# PROD: the domain that points at this server (A record). Caddy gets the HTTPS certificate for it.
PUBLIC_HOST=localhost
# PROD: the website's address (Vercel), allowed to call the API from browsers. Comma-separate several.
WEB_ORIGIN=http://localhost:3000

# --- Shared secrets ---
# Icecast passwords (Liquidsoap uses the source password to push the stream)
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_ADMIN_PASSWORD=change-me-admin
# Shared secret Liquidsoap sends to the API on track changes (must match apps/api INTERNAL_SECRET)
INTERNAL_SECRET=change-me-internal

# --- Postgres ---
POSTGRES_USER=radio
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=radio
# Host port (localhost only). apps/api/.env DATABASE_URL must use the same port.
POSTGRES_PORT=5433

# --- Liquidsoap ---
# Local dev (API via `pnpm dev` on the host): http://host.docker.internal:4000
# PROD (API in compose):                      http://api:4000
LIQUIDSOAP_API_URL=http://host.docker.internal:4000
STATION_NAME=Radio Aha
STATION_DESCRIPTION=24/7 online radio
STATION_GENRE=Various
# PROD: the website's address
STATION_URL=http://localhost:3000
STREAM_BITRATE=128
CROSSFADE_SECONDS=5.

# --- Icecast ---
ICECAST_PORT=8000
ICECAST_MAX_LISTENERS=500

# Folder with MP3s on the host (mounted at /music)
MUSIC_HOST_DIR=./music

# --- Live show (the DJ's streaming app connects here) ---
# PROD: a long random password, given only to the DJ; change it after the show.
LIVE_PASSWORD=change-me-live-password
# PROD: 0.0.0.0 so the DJ can reach port 8005 from the internet (and open 8005 in the firewall).
LIVE_BIND=127.0.0.1
LIVE_PORT=8005
# Folder where live recordings are written before they move into the music folder
RECORDINGS_HOST_DIR=./recordings

# --- Admin (/admin on the website) · PROD: set both ---
ADMIN_PASSWORD=change-me-admin-password
ADMIN_SESSION_SECRET=change-me-to-64-hex-characters-from-openssl-rand-hex-32-000000
MAX_UPLOAD_MB=300

# --- Caddy ports (only change for testing; production needs 80 and 443) ---
HTTP_PORT=80
HTTPS_PORT=443
