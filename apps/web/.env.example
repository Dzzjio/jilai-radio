# Copy to apps/web/.env.local for local dev. On Vercel, set these in Project Settings -> Environment Variables.
# All are public (baked into the static build), so never put secrets here.

# Canonical public URL of the site (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API on the VM (production: https://api.example.com)
NEXT_PUBLIC_API_URL=http://localhost:4000
# WebSocket (production: wss://api.example.com/ws)
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
# Audio stream (production via Caddy: https://api.example.com/stream)
NEXT_PUBLIC_STREAM_URL=http://localhost:8000/live
