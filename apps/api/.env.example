# Copy to apps/api/.env for local dev. In production these come from infra/.env via docker compose.

# Server
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Postgres (local dev: the compose container on localhost:5433)
DATABASE_URL=postgres://radio:change-me-postgres@localhost:5433/radio

# Shared secret Liquidsoap sends in X-Internal-Secret (must match infra/.env INTERNAL_SECRET)
INTERNAL_SECRET=change-me-internal

# Icecast (internal URL, used to poll listener stats)
ICECAST_URL=http://localhost:8000
ICECAST_MOUNT=/live
ICECAST_POLL_MS=10000

# Path where Liquidsoap sees the music folder (used to turn absolute paths into track filenames)
LIQUIDSOAP_MUSIC_DIR=/music
# Where the API writes uploaded MP3s: the same folder, as seen by the API.
# Local dev (API on the host): ../../infra/music   ·   Docker: /music
MUSIC_DIR=../../infra/music
# Where Liquidsoap writes live recordings, as seen by the API. Local dev: ../../infra/recordings · Docker: /recordings
RECORDINGS_DIR=../../infra/recordings
# Site background uploaded in admin (served at /media)
MEDIA_DIR=../../infra/media
MAX_UPLOAD_MB=300
FFPROBE_PATH=ffprobe

# Admin area (/admin on the website). Password: at least 12 characters.
ADMIN_PASSWORD=change-me-admin-password
# Signs admin sessions. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-to-64-hex-characters-from-openssl-rand-hex-32-000000

# Comma-separated list of allowed browser origins (the web app)
CORS_ORIGIN=http://localhost:3000
