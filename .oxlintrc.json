{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "nextjs"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/drizzle/**",
    "**/next-env.d.ts"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
